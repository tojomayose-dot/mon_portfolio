# URL publique du portfolio, utilisée pour les balises Open Graph et canonical.
# Copiez ce fichier en `.env` et remplacez la valeur avant la mise en ligne.
VITE_SITE_URL=https://votre-domaine.com

# ID du formulaire Formspree (https://formspree.io) utilisé par la section contact.
# Récupérez l'ID dans l'URL du formulaire : https://formspree.io/f/<ID>.
# Si laissé vide, le formulaire ouvre le client mail du visiteur (repli sans backend).
VITE_FORMSPREE_ID=
